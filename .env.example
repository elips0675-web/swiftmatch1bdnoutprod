# Supabase (optional — project uses dev-login fallback)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# API
VITE_API_URL=/api
VITE_WS_URL=ws://localhost:3002

# App
VITE_APP_NAME=SwiftMatch
VITE_APP_VERSION=1.0.0
VITE_IMAGE_BASE_URL=/demo/people
VITE_PAGINATION_LIMIT=20
VITE_CHAT_POLL_INTERVAL=3000
VITE_SESSION_TIMEOUT=3600000

# Monitoring (Sentry)
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# RevenueCat IAP (native Android/iOS only; web uses Stripe/mock)
# VITE_REVENUECAT_API_KEY=appl_xxx_xxx
