# ──────────────────────────────────────────────
# SwiftMatch API — Environment Variables
# Copy to .env and fill values before starting
# ──────────────────────────────────────────────

# Server
PORT=3002
JWT_SECRET=change-this-to-a-random-256-bit-secret
CORS_ORIGIN=http://localhost:8081
NODE_ENV=development
LOG_LEVEL=info

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=swiftmatch

# VAPID (push notifications — already generated, keep these)
VAPID_PUBLIC_KEY=BEygaffoNfy9XaaH0QqILW1Kzuf-7WoVL4oAvQpC1ebFkZ8X828d8Fv8TXcqBuykDK4IWJdZMA6TOkQfSBP8N8o
VAPID_PRIVATE_KEY=b370faewrsuKX2yUXBZ-2-axZiScdesTmpXHPq0yJN4
VAPID_SUBJECT=mailto:admin@swiftmatch.app

# SMTP (email verification / password reset)
# Dev: use Mailtrap (smtp.mailtrap.io, any user/pass works for catch-all)
# Prod: Resend / SES / SendGrid
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@swiftmatch.app

# Stripe (live keys for production, empty = mock mode)
# STRIPE_LIVE=true     # uncomment to disable mock fallback (requires valid keys)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Sentry (backend error monitoring)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Redis (distributed rate-limit + session cache + Bull queues + Socket.IO adapter)
# REDIS_URL=redis://localhost:6379
# CACHE_TTL=60              # default cache TTL in seconds
# When REDIS_URL is set, Socket.IO automatically uses Redis adapter for horizontal scaling

# Bull Queue (background jobs — email, push, image processing)
# Requires REDIS_URL. Queues start automatically on server boot.
# Queues: email (welcome/verify/reset), push (notifications), image (Sharp resize)

# S3 / DigitalOcean Spaces / Selectel (file uploads)
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# S3_BUCKET=swiftmatch-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.amazonaws.com   # custom endpoint for DO/Selectel/Yandex

# Twilio (SMS verification)
# TWILIO_ACCOUNT_SID=ACxxx
# TWILIO_AUTH_TOKEN=xxx
# TWILIO_PHONE_NUMBER=+1234567890

# AI Moderation (text via OpenAI Moderations API / image via AWS Rekognition)
# OPENAI_API_KEY=sk-xxx
# PERSPECTIVE_API_KEY=xxx
